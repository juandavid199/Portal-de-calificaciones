meta {
  name: Actualizar notas por lote (200 Exitoso)
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/api/cursos/demo-1/notas
  body: json
  auth: bearer
}

auth:bearer {
  token: {{docenteToken}}
}

