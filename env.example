# ==========================================
# 50 - Portal de Calificaciones
# Plantilla de Variables de Entorno (env.example)
# ==========================================
# REGLA DE SEGURIDAD ESTRICTA:
# 1. NUNCA subas archivos .env reales ni credenciales a Git.
# 2. Copia este archivo como .env.local para desarrollo local (ignorado por Git).
# 3. Las variables NEXT_PUBLIC_* quedan empaquetadas en el JavaScript del cliente (públicas).
# 4. Las variables del servidor (sin NEXT_PUBLIC_*) SOLO existen en el runtime del servidor
#    (Node.js / Route Handlers) y nunca se envían al navegador.

# ------------------------------------------
# Firebase Web SDK (Públicas - Identificación en el cliente)
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyDummyKey_1234567890abcdef"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="portal-calificaciones-demo.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="portal-calificaciones-demo"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="portal-calificaciones-demo.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------
# Firebase Admin SDK (Privadas - Exclusivas del Servidor / Route Handlers)
# ------------------------------------------
FIREBASE_PROJECT_ID="portal-calificaciones-demo"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-dummy@portal-calificaciones-demo.iam.gserviceaccount.com"
# En Vercel o producción, los saltos de línea se manejan como \n literales
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...DUMMY...KEY...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------
# Configuración de Sesión y Seguridad (Servidor)
# ------------------------------------------
SESSION_COOKIE_NAME="sesion"
SESSION_COOKIE_EXPIRES_IN_DAYS="5"

